	<script>
		document.getElementById('cameraButton').addEventListener('click', async () => {
try {
console.log("Activation de la caméra...");

// Accès au flux vidéo
const stream = await navigator.mediaDevices.getUserMedia({video: true});

// Sélection des éléments
const cameraOverlay = document.getElementById('cameraOverlay');
const videoElement = document.getElementById('cameraPreview');

// Afficher l'overlay avec effet flou
cameraOverlay.classList.remove('d-none');
videoElement.srcObject = stream;

console.log("Caméra activée avec succès !");
} catch (error) {
alert("Erreur d'accès à la caméra: " + error.message);
console.error("Erreur d'accès à la caméra:", error);
}
});

// Bouton pour fermer la caméra
document.getElementById('closeCamera').addEventListener('click', () => {
const cameraOverlay = document.getElementById('cameraOverlay');
const videoElement = document.getElementById('cameraPreview');

// Arrêter le flux vidéo
const stream = videoElement.srcObject;
if (stream) {
stream.getTracks().forEach(track => track.stop());
}

// Masquer l'overlay
cameraOverlay.classList.add('d-none');
});




	</script>
		
