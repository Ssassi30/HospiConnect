{% extends 'BACKOFFICE/base.html.twig' %}

{%block body%}
   <style>
/* Animation des étincelles améliorée */
.container-xxl {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
}

.spark {
  position: fixed;
  pointer-events: none;
  z-index: 0;
  opacity: 0;
  font-size: 1rem;
  animation: spark-flow 8s infinite linear;
  top: -10%;
}

@keyframes spark-flow {
  0% {
    transform: translateY(-100vh) rotate(0deg) scale(0.5);
    opacity: 0.8;
  }
  100% {
    transform: translateY(100vh) rotate(720deg) scale(1.5);
    opacity: 0;
  }
}

/* Configuration aléatoire des étincelles */
.spark:nth-child(odd) { color: #3399ff; }
.spark:nth-child(even) { color: #0066cc; }
.spark:nth-child(3n) { animation-duration: 10s; }
.spark:nth-child(5n) { animation-duration: 7s; }
.spark:nth-child(7n) { animation-delay: 2s; }

/* Contenu */
.authentication-wrapper {
  position: relative;
  z-index: 1;
}

/* Style des boutons biométriques */
.biometric-auth {
  margin: 2rem 0;
}

.biometric-btn {
  border-radius: 10px;
  padding: 0.8rem 1.5rem;
  transition: all 0.3s ease;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(5px);
}

.biometric-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 15px rgba(0, 119, 255, 0.2);
}

.biometric-btn i {
  font-size: 1.5rem;
  margin-right: 0.5rem;
}
</style>

<div class="container-xxl">
  <!-- Étincelles (30 éléments) -->
  {% for i in 1..40 %}<div class="spark" style="left: {{ random(0, 95) }}%">✦</div>{% endfor %}
      <div class="authentication-wrapper authentication-basic container-p-y">
        <div class="authentication-inner py-4">
          <!-- Forgot Password -->
          <div class="card">
            <div class="card-body">
              <!-- Logo -->
              <div class="app-brand justify-content-center">
                <a href="index.html" class="app-brand-link gap-2">
                  <span class="app-brand-logo demo">
                  <img src="{{ asset('assets/back-office/img/Logo.png') }}" 
                  </span>
                  <span class="app-brand-text demo text-body fw-bolder">HospiConnect</span>
                </a>
              </div>
              <!-- /Logo -->
              <h4 class="mb-2">Mot de passe oublié? 🔒</h4>
              <p class="mb-4">Entrez votre email et nous vous enverrons des instructions pour réinitialiser votre mot de passe</p>
              <form id="formAuthentication" class="mb-3" action="index.html" method="POST">
                <div class="mb-3">
                  <label for="email" class="form-label">Email</label>
                  <input
                    type="text"
                    class="form-control"
                    id="email"
                    name="email"
                    placeholder="Entrez votre email"
                    autofocus
                  />
                </div>
                <button class="btn btn-primary d-grid w-100">Envoyer le lien de réinitialisation</button>
              </form>
              <div class="text-center">
                <a href="{{ path('login') }}" class="d-flex align-items-center justify-content-center">
                  <i class="bx bx-chevron-left scaleX-n1-rtl bx-sm"></i>
                  Retour à la connéxion
                </a>
              </div>
            </div>
          </div>
          <!-- /Forgot Password -->
        </div>
      </div>
    </div>

    <!-- / Content -->            
{% endblock %}

