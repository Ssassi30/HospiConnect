{% extends 'BACKOFFICE/base.html.twig' %}
{% block body %}
	<style>
        /* Animation des étincelles améliorée */
        .container-xxl {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
        }

        .spark {
            position: fixed;
            pointer-events: none;
            z-index: 0;
            opacity: 0;
            font-size: 1rem;
            animation: spark-flow 8s infinite linear;
            top: -10%;
        }

        @keyframes spark-flow {
            0% {
                transform: translateY(-100vh) rotate(0deg) scale(0.5);
                opacity: 0.8;
            }
            100% {
                transform: translateY(100vh) rotate(720deg) scale(1.5);
                opacity: 0;
            }
        }

        /* Configuration aléatoire des étincelles */
        .spark:nth-child(odd) {
            color: #3399ff;
        }
        .spark:nth-child(even) {
            color: #0066cc;
        }
        .spark:nth-child(3n) {
            animation-duration: 10s;
        }
        .spark:nth-child(5n) {
            animation-duration: 7s;
        }
        .spark:nth-child(7n) {
            animation-delay: 2s;
        }

        /* Contenu */
        .authentication-wrapper {
            position: relative;
            z-index: 1;
        }

        /* Style des boutons biométriques */
        .biometric-auth {
            margin: 2rem 0;
        }

        .biometric-btn {
            border-radius: 10px;
            padding: 0.8rem 1.5rem;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(5px);
        }

        .biometric-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0, 119, 255, 0.2);
        }

        .biometric-btn i {
            font-size: 1.5rem;
            margin-right: 0.5rem;
        }
    </style>
	<div	class="container-xxl">
		<!-- Étincelles (40 éléments) -->
		{% for i in 1..40 %}
			<div	class="spark"	style="left: {{ random(0, 95) }}%">
				✦
			</div>
		{% endfor %}
		<div	class="authentication-wrapper authentication-basic container-p-y">
			<div	class="authentication-inner">
				<!-- Register Card -->
				<div	class="card">
					<div	class="card-body">
						<!-- Logo -->
						<div	class="app-brand justify-content-center">
							<a	href="#"	class="app-brand-link gap-2">
								<span	class="app-brand-logo demo">
									<img	src="{{ asset('assets/back-office/img/Logo.png') }}"	alt="Logo"	class="w-px-60 h-auto rounded-circle" />
								</span>
							</a>
						</div>
						<!-- /Logo -->
						<h4	class="mb-2">
							Bienvenue ! 🚀
						</h4>
						<p	class="mb-4">
							Créez votre compte pour accéder à un service personnalisé !
						</p>
						{{ form_start(form) }}
						<div	class="mb-3">
							{{ form_label(form.nom, 'Nom') }}
							{{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre Nom' }}
							) }}
						</div>
						<div	class="mb-3">
							{{ form_label(form.prenom, 'Prénom') }}
							{{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre Prénom' }}
							) }}
						</div>
						<div	class="mb-3">
							{{ form_label(form.date_n, 'Date de naissance') }}
							{{ form_widget(form.date_n, {'attr': {'class': 'form-control' }}
							) }}
						</div>
						<div	class="mb-3">
							{{ form_label(form.role, 'Role') }}
							{{ form_widget(form.role, {'attr': {'class': 'form-control' }}
							) }}
						</div>
						<div	class="mb-3">
							{{ form_label(form.email, 'Email') }}
							{{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Entrez votre email' }}
							) }}
						</div>
						<div	class="mb-3 form-password-toggle">
							{{ form_label(form.Mdp, 'Entrez Votre Mot de passe') }}
							<div	class="input-group input-group-merge">
								{{ form_widget(form.Mdp, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe' }}
								) }}
								<span	class="input-group-text cursor-pointer">
									<i	class="bx bx-hide"></i>
								</span>
							</div>
						</div>
						<div	class="mb-3">
							<label	for="confirmMdp">
								Confirmez votre mot de passe
							</label>
							<input	type="password"	id="confirmMdp"	name="confirmMdp"	class="form-control"	placeholder="Confirmer le mot de passe"></div>
							{#<div class="mb-3">
								<div class="form-check">
								{{ form_widget(form.terms, {'attr': {'class': 'form-check-input'}}) }}
								<label class="form-check-label" for="terms-conditions">
								Je confirme avoir lu et accepté
								<a href="{{ path('CP') }}">la politique de confidentialité et les conditions d'utilisation.</a>
								</label>
								</div>
							</div>#}
							{#<div class="mb-3">
								<div class="form-check">
								{{ form_widget(form.acceptCookies, {'attr': {'class': 'form-check-input'}}) }}
								<label class="form-check-label" for="accept-cookies">
								J'accepte l'utilisation des cookies pour améliorer mon expérience utilisateur.
								</label>
								</div>
							</div>#}
							<button	type="submit"	class="btn btn-primary d-grid w-100">
								S'inscrire
							</button>
							{{ form_end(form) }}
							<!-- Social Login Buttons -->
							<div	class="text-center mb-3">
								<p	class="mb-2">
									Ou inscrivez-vous avec
								</p>
								<div	class="d-flex justify-content-center gap-3">
									<a	href="#"	class="btn btn-icon btn-outline-danger">
										<i	class="bx bxl-google fs-4"></i>
									</a>
									<a	href="#"	class="btn btn-icon btn-outline-primary">
										<i	class="bx bxl-facebook fs-4"></i>
									</a>
									<a	href="#"	class="btn btn-icon btn-outline-dark">
										<i	class="bx bxl-apple fs-4"></i>
									</a>
								</div>
							</div>
							<p	class="text-center">
								<span>
									Vous avez déjà un compte ?
								</span>
								<a	href="{{ path('login') }}">
									<span>
										Se connecter ici
									</span>
								</a>
							</p>
						</div>
					</div>
				<!-- Register Card -->
				</div>
			</div>
		</div>
	{% endblock %}
	