														<script>
															document.querySelectorAll('.btn-supprimer').forEach(button => {
    button.addEventListener('click', function () {
        var userId = this.getAttribute('data-id');
        document.getElementById('btn-confirm-delete').setAttribute('data-id', userId);  // Sauvegarder l'ID dans le bouton de confirmation
    });
});

document.getElementById('btn-confirm-delete').addEventListener('click', function() {
    var userId = this.getAttribute('data-id');  // Récupérer l'ID de l'utilisateur à supprimer

    if (userId) {
        // Envoi de la requête de suppression
        fetch('/user/delete/' + userId, {
            method: 'POST',  // Méthode POST pour supprimer
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ delete_id: userId }),  // Envoi de l'ID dans le corps de la requête
        })
        .then(response => {
            if (!response.ok) {
                throw new Error('Erreur lors de la suppression');
            }
            return response.json();
        })
        .then(data => {
            if (data.message === "Utilisateur supprimé avec succès") {  // Afficher un message de succès
                location.reload();  // Recharger la page pour afficher les utilisateurs mis à jour
            } else {
                alert("Erreur de suppression !");
            }
        })
        .catch(error => {
            console.error('Erreur:', error);
            alert("Une erreur s'est produite !");
        });
    }
});

														</script>
