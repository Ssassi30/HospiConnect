{% extends '/BACKOFFICE/base.html.twig' %}


{% block title %}Détails du Matériel - {{ materiel.nom }}{% endblock %}

{% block body %}
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
      <span class="text-muted fw-light">Matériels /</span> Détails
    </h4>
    <div class="card-body">
  <!-- ID Matériel -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">ID Matériel</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.idMateriel }}</p>
    </div>
  </div>

  <!-- Nom -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">Nom</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.nom }}</p>
    </div>
  </div>

  <!-- Catégorie -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">Catégorie</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.categorie }}</p>
    </div>
  </div>

  <!-- État -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">État</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.etat }}</p>
    </div>
  </div>

  <!-- Quantité -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">Quantité</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.quantite }}</p>
    </div>
  </div>

  <!-- Emplacement -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">Emplacement</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.emplacement }}</p>
    </div>
  </div>

  <!-- Date d'ajout -->
  <div class="row mb-3">
    <label class="col-sm-2 col-form-label">Date d'ajout</label>
    <div class="col-sm-10">
      <p class="form-control-plaintext">{{ materiel.dateAjout ? materiel.dateAjout|date('d/m/Y') : 'N/A' }}</p>
    </div>
  </div>

  <!-- Bouton Retour -->
  <div class="row justify-content-end">
    <div class="col-sm-10">
      <a href="{{ path('app_materiel_list') }}" class="btn btn-secondary">
        <i class="bx bx-arrow-back"></i> Retour à la liste
      </a>
    </div>
  </div>
</div>


  </div>
{% endblock %}