  <div class="row">
    <div class="col-xxl">
      <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
          <h5 class="mb-0">Gestion Matériel</h5>
          <small class="text-muted float-end">Ajout / Modification</small>
        </div>
        <div class="card-body">
          {{ form_start(form) }} {# Début du formulaire Symfony #}

          <!-- ID Matériel -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.id_materiel) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-barcode"></i></span>
                {{ form_widget(form.id_materiel, {'attr': {'class': 'form-control', 'placeholder': 'ID Matériel'}}) }}
              </div>
            </div>
          </div>

          <!-- Nom -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.nom) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-label"></i></span>
                {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom du matériel'}}) }}
              </div>
            </div>
          </div>

          <!-- Catégorie -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.categorie) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-category"></i></span>
                {{ form_widget(form.categorie, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
          </div>

          <!-- État -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.etat) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-check-circle"></i></span>
                {{ form_widget(form.etat, {'attr': {'class': 'form-control'}}) }}
              </div>
            </div>
          </div>

          <!-- Quantité -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.quantite) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-box"></i></span>
                {{ form_widget(form.quantite, {'attr': {'class': 'form-control', 'placeholder': 'Quantité'}}) }}
              </div>
            </div>
          </div>

          <!-- Emplacement -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.emplacement) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-map"></i></span>
                {{ form_widget(form.emplacement, {'attr': {'class': 'form-control', 'placeholder': 'Emplacement'}}) }}
              </div>
            </div>
          </div>

          <!-- Date d'ajout -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.date_ajout) }}</label>
            <div class="col-sm-10">
              <div class="input-group input-group-merge">
                <span class="input-group-text"><i class="bx bx-calendar"></i></span>
                {{ form_widget(form.date_ajout, {'attr': {'class': 'form-control', 'type': 'date'}}) }}
              </div>
            </div>
          </div>

          <!-- Bouton Submit -->
          <div class="row justify-content-end">
            <div class="col-sm-10">
              <button type="submit" class="btn btn-primary">
                <i class="bx bx-send"></i> Envoyer
              </button>
            </div>
          </div>

          {{ form_end(form) }} {# Fin du formulaire Symfony #}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
