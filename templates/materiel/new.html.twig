{% extends '/BACKOFFICE/base.html.twig' %}

{% block title %}Ajouter un Matériel{% endblock %}

{% block body %}
  <div class="container-xxl flex-grow-1 container-p-y">
    <h4 class="fw-bold py-3 mb-4">
      <span class="text-muted fw-light">Matériels /</span> Ajouter
    </h4>

    <div class="card">
      <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
          <!-- Champ ID Matériel -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.id_materiel) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.id_materiel, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.id_materiel.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'placeholder': 'ID Matériel',
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.id_materiel.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.id_materiel) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Champ Nom -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.nom) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.nom, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.nom.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'placeholder': 'Nom du matériel',
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.nom.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.nom) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Champ Catégorie -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.categorie) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.categorie, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.categorie.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'placeholder': 'Catégorie',
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.categorie.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.categorie) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Champ État -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.etat) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.etat, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.etat.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.etat.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.etat) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Champ Quantité -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.quantite) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.quantite, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.quantite.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'placeholder': 'Quantité',
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.quantite.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.quantite) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Champ Emplacement -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.emplacement) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.emplacement, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.emplacement.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'placeholder': 'Emplacement',
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.emplacement.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.emplacement) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Champ Date d'ajout -->
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ form_label(form.date_ajout) }}</label>
            <div class="col-sm-10">
              {{ form_widget(form.date_ajout, {
                'attr': {
                  'class': 'form-control border-0 ' ~ (form.date_ajout.vars.errors|length > 0 ? 'is-invalid' : ''),
                  'style': 'height: 55px;'
                }
              }) }}
              {% if form.date_ajout.vars.errors|length > 0 %}
                <div class="invalid-feedback d-block" style="color: red;">
                  {{ form_errors(form.date_ajout) }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Bouton Enregistrer -->
          <div class="row justify-content-end">
            <div class="col-sm-10">
              <button type="submit" class="btn btn-primary">
                <i class="bx bx-save"></i> Enregistrer
              </button>
            </div>
          </div>
        {{ form_end(form) }}
      </div>
    </div>
  </div>
{% endblock %}